# Copie este arquivo para .env e preencha. NUNCA compartilhe o .env.

# Chaves da conta DEMO (OKX: app -> Demo Trading -> API; crie a chave DENTRO do modo demo)
DEMO_API_KEY=
DEMO_API_SECRET=
# DEMO_API_PASSWORD = a "passphrase" que você escolhe ao criar a chave na OKX
DEMO_API_PASSWORD=

# Chaves da conta REAL — só preencha quando sair do demo.
# Crie a chave SÓ com permissão de negociação (Trade), SEM saque, e se possível restrita ao seu IP.
API_KEY=
API_SECRET=
API_PASSWORD=

# Chaves da TESTNET da Binance (opcional)
TESTNET_API_KEY=
TESTNET_API_SECRET=

# Precisa ser SIM para o robô aceitar operar com dinheiro real
CONFIRMAR_REAL=NAO
